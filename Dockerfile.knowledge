FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props ./
COPY src/SmoothAiProductContextMemory.Knowledge/ src/SmoothAiProductContextMemory.Knowledge/
COPY src/SmoothAiProductContextMemory.KnowledgeHost/ src/SmoothAiProductContextMemory.KnowledgeHost/
COPY .agents/skills/mimisbrunnr-odin-context-memory/scripts/redact.py .agents/skills/mimisbrunnr-odin-context-memory/scripts/redact.py
COPY .agents/skills/mimisbrunnr-odin-context-memory/scripts/atomicity.py .agents/skills/mimisbrunnr-odin-context-memory/scripts/atomicity.py
RUN dotnet publish src/SmoothAiProductContextMemory.KnowledgeHost -c Release -o /app
FROM mcr.microsoft.com/dotnet/aspnet:10.0
ARG REVISION=unknown
LABEL org.opencontainers.image.revision=$REVISION
LABEL org.opencontainers.image.source="https://github.com/generic-automation-and-it/smooth-ai-product-context-memory"
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./
RUN mkdir -p /app/data && chown -R app:app /app/data
USER app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
VOLUME /app/data
ENTRYPOINT ["dotnet", "SmoothAiProductContextMemory.KnowledgeHost.dll"]
