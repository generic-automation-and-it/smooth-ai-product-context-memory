{
  "Logging": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Debug",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.AspNetCore": "Information",
          "Microsoft.EntityFrameworkCore": "Warning",
          "Microsoft.Hosting.Lifetime": "Information",
          "Npgsql": "Warning",
          "OpenTelemetry": "Warning",
          "System": "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
          }
        }
      ]
    }
  }
}
