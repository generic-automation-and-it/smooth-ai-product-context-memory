{
  "Logging": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.EntityFrameworkCore": "Warning",
          "Microsoft.Extensions.Http.Resilience": "Warning",
          "Microsoft.Hosting.Lifetime": "Information",
          "Npgsql": "Warning",
          "OpenTelemetry": "Warning",
          "Polly": "Warning",
          "System": "Warning"
        }
      },
      "Enrich": [ "FromLogContext" ],
      "WriteTo": [
        {
          "Name": "Console"
        }
      ]
    }
  },
  "AllowedHosts": "*"
}
