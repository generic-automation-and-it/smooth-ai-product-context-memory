<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmoothAiProductContextMemory.AppHost</RootNamespace>
    <IsAspireHost>true</IsAspireHost>
    <!-- NuGet-restored orchestration dependencies: Dockerfile.apphost copies the DCP and dashboard
         tools from the package cache, so the 13.6 CLI bundle is deliberately not used. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>smooth-project-memory-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmoothAiProductContextMemory.Host\SmoothAiProductContextMemory.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmoothAiProductContextMemory.AppHost.UnitTest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Seq" />
    <!-- MessagePack pinned transitively (via Aspire) to the patched 2.5.303+ line — fixes the NU1902 audit advisories on CI (GHSA-qhrr-8q5h-9q3h). Version lives in Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

</Project>
